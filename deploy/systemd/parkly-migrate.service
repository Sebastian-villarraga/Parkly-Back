[Unit]
Description=Apply PARKLY Backend database migrations
After=network.target

[Service]
Type=oneshot
User=parkly
Group=parkly
WorkingDirectory=/opt/parkly/backend
EnvironmentFile=/etc/parkly/backend.env
ExecStart=/usr/bin/node /opt/parkly/backend/node_modules/prisma/build/index.js migrate deploy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
