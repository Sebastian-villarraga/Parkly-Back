[Unit]
Description=PARKLY Backend API
After=network.target

[Service]
Type=simple
User=parkly
Group=parkly
WorkingDirectory=/opt/parkly/backend
EnvironmentFile=/etc/parkly/backend.env
ExecStart=/usr/bin/node /opt/parkly/backend/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
